# Runtime mode. Production forbids fake/demo data and local JSON DB fallback.
APP_MODE="production"

# Production persistence. Required when APP_MODE=production.
DATABASE_URL=""

# AI provider is configured centrally by the application operator.
# End users do not see or control these values.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Supported: openai_chat | openai_responses | gemini_native
AI_API_FORMAT="openai_chat"
AI_PROVIDER_NAME="Configured AI"

# Optional public monitoring provider. Not required and not the primary architecture.
# Leave empty to use authenticated Android device-session monitoring.
PUBLIC_PROVIDER=""
APIFY_API_TOKEN=""

# Notification infrastructure (optional until push delivery is enabled).
FCM_SERVER_KEY=""

# Hosting URL, injected by some deployment environments.
APP_URL=""
