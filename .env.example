# =========================
# Runtime / persistence
# =========================
# Production forbids fake/demo data and local JSON DB fallback.
APP_MODE="production"

# Required when APP_MODE=production.
DATABASE_URL=""

# Public backend origin compiled into the Android bundle.
# Same-origin web deployments may leave this empty.
# Android production/alpha builds must use an absolute HTTPS origin.
# Example: https://api.mrscrap.app
VITE_API_BASE_URL=""

# Public browser origin for CORS when web frontend and API are on different origins.
APP_URL=""
# Optional comma-separated additional browser origins.
CORS_ALLOWED_ORIGINS=""

# =========================
# Centrally managed AI
# =========================
# Controlled by the application operator. End users never receive these secrets.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Supported: openai_chat | openai_responses | gemini_native
AI_API_FORMAT="openai_chat"
AI_PROVIDER_NAME="Configured AI"

# Protects operator-only internal endpoints such as /api/internal/ai/health in production.
# Use a long random secret. Never ship this value in frontend or Android bundles.
ADMIN_API_TOKEN=""

# =========================
# Optional public connector
# =========================
# Authenticated Android device-session monitoring is the primary architecture.
# Leave these empty unless the operator explicitly enables an optional public adapter.
PUBLIC_PROVIDER=""
APIFY_API_TOKEN=""

# =========================
# Notifications (future external delivery)
# =========================
# In-app notification records work without this. Real FCM delivery is not yet implemented.
FCM_SERVER_KEY=""
